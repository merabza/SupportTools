<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="BaGetter" value="https://bagetter.merab.pvt.ge/v3/index.json" />
        <add key="GPIH" value="https://lib.gpih.ge/nuget/localfeed/" />
    </packageSources>
    <packageSourceMapping>
        <!-- Map all packages from nuget.org by default -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <!-- Locally published packages come from BaGetter -->
        <packageSource key="BaGetter">
            <package pattern="SystemTools.*" />
            <package pattern="AppCliTools.*" />
            <package pattern="ConnectionTools.*" />
            <package pattern="DatabaseTools.*" />
            <package pattern="ParametersManagement.*" />
            <package pattern="SupportToolsServerShared.*" />
            <package pattern="ToolsManagement.*" />
            <package pattern="WebAgentContracts.*" />
        </packageSource>
        <!-- GPIH packages -->
        <packageSource key="GPIH">
            <package pattern="Insurance.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>